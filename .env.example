# Plantilla del .env — cópiala a «.env» y rellena los valores.
#
#     cp .env.example .env
#
# El .env va junto a manage.py y NO se sube a git (está en .gitignore). Aquí
# no hay ni una credencial de verdad: son ejemplos con la forma que tienen.
#
# En cPanel hay dos maneras de poner esto, y las dos valen:
#   - subiendo un .env a la carpeta de la aplicación, o
#   - escribiendo las variables en «Setup Python App» > Environment variables.
# Si una variable está en los dos sitios gana la de cPanel, porque
# load_dotenv() no pisa lo que ya está en el entorno.


# ── WebService de Service24GPS ────────────────────────────────────────────
# De aquí salen las timbradas y las posiciones de la flota. Sin esto el
# dashboard abre pero sale vacío.
GPS_API_BASE_URL=https://api.service24gps.com/api/v1
GPS_APIKEY=pon-aqui-tu-apikey
GPS_USERNAME=pon-aqui-tu-usuario
GPS_PASSWORD=pon-aqui-tu-clave


# ── Django ────────────────────────────────────────────────────────────────
# Firma la cookie de sesión. En producción es OBLIGATORIA: sin ella se usa la
# clave de ejemplo que está en config/settings.py, que está en un repositorio
# público, y con ella cualquiera puede fabricarse una sesión válida y entrar.
# Para generar una:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cadena-larga-y-aleatoria-distinta-en-cada-servidor

# 0 en el servidor, 1 solo en tu máquina. Con 1, cualquier error le enseña el
# código, las variables locales y las credenciales a quien lo provoque.
DJANGO_DEBUG=0

# Dominios que puede servir esta instalación, separados por comas y sin
# https://. Con DJANGO_DEBUG=0 y el dominio fuera de la lista, Django contesta
# 400 a todo: es lo primero que hay que mirar si el sitio recién mudado no abre.
DJANGO_ALLOWED_HOSTS=dashboardgps.qd.je,www.dashboardgps.qd.je

# Los mismos dominios pero con https:// delante. Django los compara contra la
# cabecera Origin de cada POST; si falta el dominio, el login contesta «CSRF
# verification failed» aunque el correo y la clave estén bien.
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboardgps.qd.je,https://www.dashboardgps.qd.je

# Subcarpeta donde se monta la aplicación, cuando no está en la raíz del
# dominio. Tiene que coincidir con el «Application URL» de cPanel:
#   - https://dominio.com/          -> deja esta línea comentada
#   - https://dominio.com/dashboard -> DJANGO_FORCE_SCRIPT_NAME=/dashboard
# Con barra al principio y sin barra al final. Si está mal puesta, los enlaces
# y el CSS salen apuntando a donde no es.
#DJANGO_FORCE_SCRIPT_NAME=/dashboard


# ── Base de datos (Supabase) ──────────────────────────────────────────────
# Aquí viven las cuentas del dashboard (DashboardUsuario) y la flota
# (FlotaVehiculo). Sin esta variable, Django cae a un sqlite local: sirve para
# desarrollo, pero en el servidor significa que las cuentas que des de alta en
# /admin/ viven en un archivo suelto del hosting.
#
# El valor sale de Supabase > Project Settings > Database. Usa el «Transaction
# pooler» (puerto 6543): abre y cierra conexiones sin coste, que es lo que
# conviene cuando Passenger levanta y apaga procesos. Si el hosting tiene
# cerrado el 6543 hacia fuera, prueba el «Session pooler» (5432).
DATABASE_URL=postgresql://postgres.abcdefghijklmno:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres


# ── Cache (opcional) ──────────────────────────────────────────────────────
# Sin REDIS_URL, el cache vive en la memoria del proceso de Passenger, que es
# lo normal y no hace falta tocarlo. Solo se pone si algún día la aplicación
# corre en varios procesos que deban compartir el cache.
#REDIS_URL=redis://usuario:clave@host:6379/0
#REDIS_PREFIX=dashboard-gps


# ── Acceso de emergencia ──────────────────────────────────────────────────
# Las cuentas de verdad son filas de DashboardUsuario y se dan de alta desde
# /admin/. Esto de aquí abajo es solo la puerta de atrás para cuando la base
# de datos no conteste, y para la primera vez, cuando todavía no hay cuentas.
#
# Cada pareja CORREO/CLAVE va junta: con una sola puesta, Django no arranca y
# dice cuál falta. Para volver al valor por defecto hay que BORRAR la línea,
# no dejarla vacía. Con DJANGO_DEBUG=0 y ninguna pareja puesta, no existe
# ninguna cuenta de emergencia y se entra solo con las de la tabla.
#DASHBOARD_CORREO_ADMIN=admin@tu-dominio.com
#DASHBOARD_CLAVE_ADMIN=una-clave-larga
#DASHBOARD_CORREO_PROCAPS=procaps@tu-dominio.com
#DASHBOARD_CLAVE_PROCAPS=una-clave-larga
#DASHBOARD_CORREO_DITAR=ditar@tu-dominio.com
#DASHBOARD_CLAVE_DITAR=una-clave-larga
#DASHBOARD_CORREO_RELIANZ=relianz@tu-dominio.com
#DASHBOARD_CLAVE_RELIANZ=una-clave-larga
